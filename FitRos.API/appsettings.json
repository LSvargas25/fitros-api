{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=fitros;Username=postgres;Password=REPLACE_VIA_ENV_VAR_ConnectionStrings__DefaultConnection"
  },

  "Jwt": {
    "Issuer": "FitRos.API",
    "Audience": "FitRos.Client",
    "SigningKey": "REPLACE_VIA_ENV_VAR_Jwt__SigningKey_min-32-chars"
  },

  "Smtp": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "Username": "REPLACE_VIA_ENV_VAR_Smtp__Username",
    "Password": "REPLACE_VIA_ENV_VAR_Smtp__Password",
    "From": "REPLACE_VIA_ENV_VAR_Smtp__From"
  },

  "Frontend": {
    "BaseUrl": "http://localhost:4200"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*"
}
